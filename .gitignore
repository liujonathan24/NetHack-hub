# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/

# Env / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.so

# Engine build artifacts (nethack_core is an external dependency; never vendor it here)
environments/nethack/nethack_core/
libnethack.so
dat/

# OS / editor
.DS_Store
*.swp
.venv

# CLI-harness-eval run artifacts (tools/cli_harness_eval/launch_cell.sh):
# bulky per-turn traces, per-rollout `traces.jsonl`, eval logs and resolved
# configs from real runs. Acceptance artifacts are committed deliberately
# under tools/cli_harness_eval/acceptance/ -- these patterns don't touch
# that directory. Keep any aggregated table.md / table.json a run's
# tools/cli_harness_eval/aggregate.py produces (not matched below).
/outputs/cli_harness_eval/**/traces.jsonl
/outputs/cli_harness_eval/**/turns/
/outputs/cli_harness_eval/**/eval.log
/outputs/cli_harness_eval/**/config.toml
# The eval CLI's default per-run dir (`<env>--<model>--<harness>/<uuid>/`)
# when `--output_dir` isn't passed explicitly (ad-hoc `eval` invocations,
# not launch_cell.sh, which always sets `--output_dir`).
/outputs/nethack_v1--*/
/outputs/*--bash/
