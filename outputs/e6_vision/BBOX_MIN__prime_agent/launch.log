        "content": "190: \n191:     async def _resolve_config(self) -> tuple[str | None, dict[str, str]]:\n192:         \"\"\"Host-resolved (url, extra_headers), honoring a user's mcpServers override.\n193:         Falls back to the class ``url`` and no extra headers on host error.\"\"\"\n194:         try:\n195:             cfg = await host_request(\"mcp.config\", {\"server\": self.server})\n196:         except RuntimeError:\n197:             cfg = {}\n198:         url = cfg.get(\"url\") if isinstance(cfg, dict) else None\n199:         headers = cfg.get(\"headers\") if isinstance(cfg, dict) else None\n200:         if not (isinstance(url, str) and url):\n201:             url = self.url\n202:         extra = headers if isinstance(headers, dict) else {}\n203:         return url, {str(k): str(v) for k, v in extra.items()}\n204: \n205:     async def _open_session(self, stack: AsyncExitStack):\n206:         \"\"\"Open an initialized MCP ClientSession bound to ``stack``.\n207: \n208:         Override for non-HTTP transports (e.g. stdio). The default connects over\n209:         streamable HTTP with a Bearer token from auth.json. The URL comes from the\n210:         host (mcpServers override) when available, else ``self.url``.\n211:         \"\"\"\n212:         import inspect  # noqa: PLC0415\n213: \n214:         from mcp import ClientSession  # noqa: PLC0415\n215: \n216:         url, extra_headers = await self._resolve_config()\n217:         if not url:\n218:             raise ValueError(\n219:                 f\"{type(self).__name__} must set `url` or override `_open_session`\"\n220:             )\n221:         token = await self._resolve_token()\n222:         transport = _resolve_streamable_http()\n223:         # Extra configured headers first, Authorization last so it always wins.\n224:         auth_header = {**extra_headers, \"Authorization\": f\"Bearer {token}\"}\n225: \n226:         # SDK signatures vary: some take headers=, others only http_client=.\n227:         params = inspect.signature(transport).parameters\n228:         if \"headers\" in params:\n229:             cm = transport(url, headers=auth_header)\n230:         elif \"http_client\" in params:\n231:             import httpx  # noqa: PLC0415\n232: \n233:             client = await stack.enter_async_context(httpx.AsyncClient(headers=auth_header))\n234:             cm = transport(url, http_client=client)\n235:         else:\n236:             raise RuntimeError(\n237:                 f\"unsupported mcp streamable-HTTP client signature: {tuple(params)}\"\n238:             )\n239: \n240:         read, write, *_ = await stack.enter_async_context(cm)\n241:         session = await stack.enter_async_context(ClientSession(read, write))\n242:         await session.initialize()\n243:         return session\n244: \n245:     # -- tools --------------------------------------------------------------\n246: \n247:     async def list_tools(self) -> list[dict[str, Any]]:\n248:         \"\"\"Return the server's tools as ``[{name, description, inputSchema}]``.\"\"\"\n249:         await self._ensure_tools()\n250:         return [dict(t) for t in (self._tools or {}).values()]\n251: \n252:     async def _ensure_tools(self) -> None:\n253:         if self._tools is not None:\n254:             return\n255:         async with self._lock:\n256:             if self._tools is not None:\n257:                 return\n258:             async with AsyncExitStack() as stack:\n259:                 session = await self._open_session(stack)\n",
