        "tool_call_id": "call_ECfaA2sRysiTTzYZhc3BCX9d",
        "content": "class NetHack(McpIntegration):\n    server = \"nethack\"\n    url = None\n    bearer_token_env = \"NETHACK_MCP_TOKEN\"\n\n",
