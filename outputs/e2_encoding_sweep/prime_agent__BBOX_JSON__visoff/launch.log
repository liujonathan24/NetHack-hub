            "arguments": "{\"code\": \"\\n# Let me try calling a tool directly with httpx and a longer timeout\\nimport httpx\\nimport json\\n\\nurl = \\\"http://127.0.0.1:43255/mcp\\\"\\ntoken = os.environ[\\\"NETHACK_MCP_TOKEN\\\"]\\nheaders = {\\n    \\\"Content-Type\\\": \\\"application/json\\\",\\n    \\\"Accept\\\": \\\"application/json\\\",\\n    \\\"Authorization\\\": f\\\"Bearer {token}\\\",\\n}\\n\\nasync def mcp_call(method, params=None, timeout=120):\\n    \\\"\\\"\\\"Make a raw MCP JSON-RPC call.\\\"\\\"\\\"\\n    payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 1, \\\"method\\\": method}\\n    if params:\\n        payload[\\\"params\\\"] = params\\n    \\n    async with httpx.AsyncClient(timeout=timeout) as client:\\n        # First initialize\\n        init_payload = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 0, \\\"method\\\": \\\"initialize\\\", \\n                        \\\"params\\\": {\\\"protocolVersion\\\": \\\"2024-11-05\\\", \\\"capabilities\\\": {}, \\n                                   \\\"clientInfo\\\": {\\\"name\\\": \\\"test\\\", \\\"version\\\": \\\"0.1\\\"}}}\\n        resp = await client.post(url, json=init_payload, headers=headers)\\n        session_id = resp.headers.get(\\\"mcp-session-id\\\", \\\"\\\")\\n        if session_id:\\n            headers[\\\"mcp-session-id\\\"] = session_id\\n        \\n        # Send initialized notification\\n        notif = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"method\\\": \\\"notifications/initialized\\\"}\\n        await client.post(url, json=notif, headers=headers)\\n        \\n        # Make the actual call\\n        resp = await client.post(url, json=payload, headers=headers)\\n        return resp.json()\\n\\n# Try listing tools first\\nresult = await mcp_call(\\\"tools/list\\\")\\nprint(json.dumps(result, indent=2)[:2000])\\n\"}"
