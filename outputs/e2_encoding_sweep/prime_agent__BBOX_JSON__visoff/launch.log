            "arguments": "{\"code\": \"\\n# Create a persistent session helper for game calls\\nimport httpx\\nimport json\\nimport os\\n\\n_url = \\\"http://127.0.0.1:43255/mcp\\\"\\n_token = os.environ[\\\"NETHACK_MCP_TOKEN\\\"]\\n\\nasync def game_call(tool_name, **kwargs):\\n    \\\"\\\"\\\"Call a NetHack MCP tool with a long timeout.\\\"\\\"\\\"\\n    headers = {\\n        \\\"Content-Type\\\": \\\"application/json\\\",\\n        \\\"Accept\\\": \\\"application/json\\\",\\n        \\\"Authorization\\\": f\\\"Bearer {_token}\\\",\\n    }\\n    \\n    async with httpx.AsyncClient(timeout=httpx.Timeout(300.0, connect=30.0)) as client:\\n        # Initialize\\n        init = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 0, \\\"method\\\": \\\"initialize\\\",\\n                \\\"params\\\": {\\\"protocolVersion\\\": \\\"2024-11-05\\\", \\\"capabilities\\\": {},\\n                           \\\"clientInfo\\\": {\\\"name\\\": \\\"nethack-agent\\\", \\\"version\\\": \\\"0.1\\\"}}}\\n        resp = await client.post(_url, json=init, headers=headers)\\n        session_id = resp.headers.get(\\\"mcp-session-id\\\", \\\"\\\")\\n        if session_id:\\n            headers[\\\"mcp-session-id\\\"] = session_id\\n        \\n        # Initialized notification\\n        notif = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"method\\\": \\\"notifications/initialized\\\"}\\n        await client.post(_url, json=notif, headers=headers)\\n        \\n        # Call the tool\\n        call = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": 1, \\\"method\\\": \\\"tools/call\\\",\\n                \\\"params\\\": {\\\"name\\\": tool_name, \\\"arguments\\\": kwargs}}\\n        resp = await client.post(_url, json=call, headers=headers)\\n        data = resp.json()\\n        \\n        if \\\"error\\\" in data:\\n            return f\\\"ERROR: {json.dumps(data['error'])}\\\"\\n        \\n        # Extract text content from result\\n        result = data.get(\\\"result\\\", {})\\n        content = result.get(\\\"content\\\", [])\\n        texts = []\\n        for item in content:\\n            if isinstance(item, dict) and item.get(\\\"type\\\") == \\\"text\\\":\\n                texts.append(item[\\\"text\\\"])\\n            elif isinstance(item, dict) and \\\"text\\\" in item:\\n                texts.append(item[\\\"text\\\"])\\n        return \\\"\\\\n\\\".join(texts)\\n\\n# Now try looking at the game\\nresult = await game_call(\\\"np_look\\\")\\nprint(result)\\n\"}"
