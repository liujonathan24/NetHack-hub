            "arguments": "{\"code\": \"\\n# Create a helper function that handles timeouts gracefully\\nasync def nh_call(func, *args, **kwargs):\\n    \\\"\\\"\\\"Call a nethack function with timeout retry logic.\\\"\\\"\\\"\\n    max_retries = 3\\n    for attempt in range(max_retries):\\n        try:\\n            result = await func(*args, **kwargs)\\n            return result\\n        except Exception as e:\\n            if attempt < max_retries - 1:\\n                print(f\\\"  Attempt {attempt+1} failed ({type(e).__name__}), retrying...\\\")\\n                await asyncio.sleep(15)\\n            else:\\n                print(f\\\"  All retries failed. Last error: {type(e).__name__}\\\")\\n                # Try a simple look to get state\\n                await asyncio.sleep(10)\\n                try:\\n                    result = await nethack.np_look()\\n                    return result\\n                except:\\n                    return None\\n\\n# Test it\\nresult = await nh_call(nethack.np_look)\\nprint(result)\\n\"}"
