            "arguments": "{\"code\":\"\\n# Set up a persistent helper for MCP calls\\nimport json, httpx, os\\n\\nMCP_URL = \\\"http://127.0.0.1:36091/mcp\\\"\\nMCP_TOKEN = os.environ.get(\\\"NETHACK_MCP_TOKEN\\\")\\nMCP_HEADERS = {\\n    \\\"Authorization\\\": f\\\"Bearer {MCP_TOKEN}\\\",\\n    \\\"Content-Type\\\": \\\"application/json\\\",\\n    \\\"Accept\\\": \\\"application/json\\\",\\n}\\n_call_id = 0\\n\\nasync def nh(tool_name, arguments=None, timeout=300.0):\\n    \\\"\\\"\\\"Call a NetHack MCP tool and return the text result.\\\"\\\"\\\"\\n    global _call_id\\n    _call_id += 1\\n    payload = {\\n        \\\"jsonrpc\\\": \\\"2.0\\\",\\n        \\\"id\\\": _call_id,\\n        \\\"method\\\": \\\"tools/call\\\",\\n        \\\"params\\\": {\\n            \\\"name\\\": tool_name,\\n            \\\"arguments\\\": arguments or {}\\n        }\\n    }\\n    async with httpx.AsyncClient(timeout=timeout) as client:\\n        resp = await client.post(MCP_URL, json=payload, headers=MCP_HEADERS)\\n        data = resp.json()\\n        if \\\"error\\\" in data:\\n            raise Exception(f\\\"MCP Error: {data['error']}\\\")\\n        result = data.get(\\\"result\\\", {})\\n        # Extract text from content\\n        texts = []\\n        for block in result.get(\\\"content\\\", []):\\n            if block.get(\\\"type\\\") == \\\"text\\\":\\n                texts.append(block[\\\"text\\\"])\\n        return \\\"\\\\n\\\".join(texts)\\n\\n# Quick test\\nr = await nh(\\\"np_look\\\")\\nprint(r)\\n\"}"
          }
        ]
      },
