            "name": "ipython",
            "arguments": "{\"code\": \"\\n# Let's list the available tools from the nethack server\\ntools = await nethack.list_tools()\\nfor t in tools:\\n    print(f\\\"=== {t['name']} ===\\\")\\n    print(t.get('description', '')[:200])\\n    schema = t.get('inputSchema', {})\\n    if schema.get('properties'):\\n        for prop, info in schema['properties'].items():\\n            print(f\\\"  arg: {prop} - {info.get('type','?')} - {info.get('description','')[:100]}\\\")\\n    print()\\n\"}"
          }
