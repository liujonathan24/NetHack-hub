            "arguments": "{\"code\": \"\\n# Create a persistent MCP client helper\\nimport httpx\\nimport json\\n\\nMCP_URL = \\\"http://127.0.0.1:38399/mcp\\\"\\nMCP_TOKEN = os.environ['NETHACK_MCP_TOKEN']\\nMCP_HEADERS = {\\n    \\\"Authorization\\\": f\\\"Bearer {MCP_TOKEN}\\\",\\n    \\\"Content-Type\\\": \\\"application/json\\\",\\n    \\\"Accept\\\": \\\"application/json, text/event-stream\\\",\\n}\\n\\n_call_id = 0\\n\\nasync def mcp_call(tool_name, **kwargs):\\n    \\\"\\\"\\\"Call an MCP tool directly, managing session lifecycle.\\\"\\\"\\\"\\n    global _call_id\\n    timeout = httpx.Timeout(30, read=300)\\n    async with httpx.AsyncClient(headers=MCP_HEADERS, timeout=timeout) as client:\\n        # Initialize\\n        _call_id += 1\\n        init_id = _call_id\\n        init_req = {\\n            \\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": init_id, \\\"method\\\": \\\"initialize\\\",\\n            \\\"params\\\": {\\\"protocolVersion\\\": \\\"2024-11-05\\\", \\\"capabilities\\\": {}, \\n                       \\\"clientInfo\\\": {\\\"name\\\": \\\"agent\\\", \\\"version\\\": \\\"1.0\\\"}}\\n        }\\n        resp = await client.post(MCP_URL, json=init_req)\\n        init_result = resp.json()\\n        \\n        # Send initialized notification\\n        notif = {\\\"jsonrpc\\\": \\\"2.0\\\", \\\"method\\\": \\\"notifications/initialized\\\"}\\n        await client.post(MCP_URL, json=notif)\\n        \\n        # Call the tool\\n        _call_id += 1\\n        tool_id = _call_id\\n        tool_req = {\\n            \\\"jsonrpc\\\": \\\"2.0\\\", \\\"id\\\": tool_id, \\\"method\\\": \\\"tools/call\\\",\\n            \\\"params\\\": {\\\"name\\\": tool_name, \\\"arguments\\\": kwargs}\\n        }\\n        resp2 = await client.post(MCP_URL, json=tool_req)\\n        result = resp2.json()\\n        \\n        if \\\"error\\\" in result:\\n            return f\\\"ERROR: {result['error']}\\\"\\n        \\n        content = result.get(\\\"result\\\", {}).get(\\\"content\\\", [])\\n        texts = [c.get(\\\"text\\\", \\\"\\\") for c in content if c.get(\\\"type\\\") == \\\"text\\\"]\\n        return \\\"\\\\n\\\".join(texts)\\n\\n# Test it\\nresult = await mcp_call(\\\"np_look\\\")\\nprint(result)\\n\"}"
