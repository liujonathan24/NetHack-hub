            "arguments": "{\"code\": \"# Monkey-patch _open_session to use longer timeouts\\nimport httpx\\nfrom contextlib import AsyncExitStack\\nimport inspect as _inspect\\n\\nasync def patched_open_session(self, stack):\\n    from mcp import ClientSession\\n    from mcp.client import streamable_http as _sh\\n    \\n    url, extra_headers = await self._resolve_config()\\n    if not url:\\n        raise ValueError(f\\\"{type(self).__name__} must set `url` or override `_open_session`\\\")\\n    token = await self._resolve_token()\\n    \\n    auth_header = {**extra_headers, \\\"Authorization\\\": f\\\"Bearer {token}\\\"}\\n    \\n    # Create httpx client with much longer timeout (300 seconds)\\n    client = httpx.AsyncClient(\\n        headers=auth_header,\\n        timeout=httpx.Timeout(300.0, connect=10.0)\\n    )\\n    client = await stack.enter_async_context(client)\\n    \\n    transport_fn = None\\n    for name in (\\\"streamablehttp_client\\\", \\\"streamable_http_client\\\"):\\n        fn = getattr(_sh, name, None)\\n        if fn is not None:\\n            transport_fn = fn\\n            break\\n    \\n    cm = transport_fn(url, http_client=client)\\n    read, write, *_ = await stack.enter_async_context(cm)\\n    session = await stack.enter_async_context(ClientSession(read, write))\\n    await session.initialize()\\n    return session\\n\\nnh_module.NetHack._open_session = patched_open_session\\n\\n# Clear tools cache\\nnethack.nethack._tools = None\\n\\n# Try listing tools again\\ntools = await nethack.nethack.list_tools()\\nprint(f\\\"Found {len(tools)} tools\\\")\\n\"}"
