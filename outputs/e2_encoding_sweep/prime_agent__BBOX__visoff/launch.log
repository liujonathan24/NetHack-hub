        "content": "L645:     \"\"\"Client transport for StreamableHTTP.\nL646: \nL647:     Args:\nL648:         url: The MCP server endpoint URL.\nL649:         http_client: Optional pre-configured httpx2.AsyncClient. If None, a default\nL650:             client with recommended MCP timeouts will be created. To configure headers,\nL651:             authentication, or other HTTP settings, create an httpx2.AsyncClient and pass it here.\nL652:         terminate_on_close: If True, send a DELETE request to terminate the session when the context exits.\nL653: \nL654:     Yields:\nL655:         Tuple containing:\nL656:             - read_stream: Stream for reading messages from the server\nL657:             - write_stream: Stream for sending messages to the server\nL658: \nL659:     Example:\nL660:         See examples/snippets/clients/ for usage patterns.\nL661:     \"\"\"\nL662:     # Determine if we need to create and manage the client\nL663:     client_provided = http_client is not None\nL664:     client = http_client\nL665: \nL666:     if client is None:\nL667:         # Create default client with recommended MCP timeouts\nL668:         client = create_mcp_http_client()\nL669: \nL670:     transport = StreamableHTTPTransport(url)\nL671: \nL672:     logger.debug(f\"Connecting to StreamableHTTP endpoint: {url}\")\nL673: \nL674:     async with contextlib.AsyncExitStack() as stack:\nL675:         # Only manage client lifecycle if we created it\nL676:         if not client_provided:\nL677:             await stack.enter_async_context(client)\nL678: \nL679:         read_stream_writer, read_stream = create_context_streams[SessionMessage | Exception](0)\nL680:         write_stream, write_stream_reader = create_context_streams[SessionMessage](0)\nL681: \nL682:         async with (\nL683:             read_stream_writer,\nL684:             read_stream,\nL685:             write_stream,\nL686:             write_stream_reader,\nL687:             anyio.create_task_group() as tg,\nL688:         ):\nL689: \nL690:             def start_get_stream() -> None:\nL691:                 tg.start_soon(transport.handle_get_stream, client, read_stream_writer)\nL692: \nL693:             tg.start_soon(\nL694:                 transport.post_writer,\nL695:                 client,\nL696:                 write_stream_reader,\nL697:                 read_stream_writer,\nL698:                 write_stream,\nL699:                 start_get_stream,\n",
