            "name": "ipython",
            "arguments": "{\"code\": \"\\n# The streamable_http_client takes an http_client parameter. Let me create a custom \\n# session with a longer timeout. I'll monkey-patch the _open_session method to use\\n# an httpx client with a longer read timeout.\\n\\nimport httpx\\nimport asyncio\\nfrom contextlib import AsyncExitStack\\nfrom mcp import ClientSession\\n\\nasync def custom_open_session(self, stack):\\n    from rlm.mcp_base import _resolve_streamable_http, host_request\\n    url, extra_headers = await self._resolve_config()\\n    if not url:\\n        raise ValueError(f\\\"{type(self).__name__} must set `url` or override `_open_session`\\\")\\n    token = await self._resolve_token()\\n    transport = _resolve_streamable_http()\\n    auth_header = {**extra_headers, \\\"Authorization\\\": f\\\"Bearer {token}\\\"}\\n    \\n    # Create httpx client with a longer timeout (120 seconds)\\n    client = await stack.enter_async_context(httpx.AsyncClient(\\n        headers=auth_header,\\n        timeout=httpx.Timeout(120.0, connect=30.0)\\n    ))\\n    cm = transport(url, http_client=client)\\n    read, write, *_ = await stack.enter_async_context(cm)\\n    session = await stack.enter_async_context(ClientSession(read, write))\\n    await session.initialize()\\n    return session\\n\\n# Monkey-patch\\nfrom rlm.mcp_base import McpIntegration\\nMcpIntegration._open_session = custom_open_session\\n\\nprint(\\\"Patched _open_session with 120s timeout\\\")\\n\"}"
