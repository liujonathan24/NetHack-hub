            "arguments": "{\"code\":\"\\n# Let me create a helper to explore and find stairs, then descend\\nasync def explore_and_descend():\\n    \\\"\\\"\\\"Explore the current level, find stairs down, and descend.\\\"\\\"\\\"\\n    # First explore to find stairs\\n    for _ in range(5):  # Try exploring up to 5 times\\n        result = await nethack.np_explore_level()\\n        result_str = str(result)\\n        print(result_str[:500])\\n        print(\\\"---\\\")\\n        \\n        # Check if stairs down appeared\\n        if 'stairs down' in result_str.lower() or 'stairs DOWN' in result_str:\\n            # Find the stairs position from the result\\n            import re\\n            match = re.search(r'stairs [Dd]own at \\\\((\\\\d+),\\\\s*(\\\\d+)\\\\)', result_str)\\n            if match:\\n                sx, sy = int(match.group(1)), int(match.group(2))\\n                print(f\\\"Found stairs down at ({sx},{sy})\\\")\\n                move_result = await nethack.np_move_to(x=sx, y=sy)\\n                print(str(move_result)[:300])\\n                down_result = await nethack.np_down()\\n                print(str(down_result)[:300])\\n                return True\\n        \\n        # Check for danger\\n        if 'HP' in result_str:\\n            import re\\n            hp_match = re.search(r'HP: (\\\\d+)/(\\\\d+)', result_str)\\n            if hp_match:\\n                hp = int(hp_match.group(1))\\n                max_hp = int(hp_match.group(2))\\n                if hp < max_hp * 0.4:\\n                    print(f\\\"Low HP ({hp}/{max_hp}), stopping exploration\\\")\\n                    return False\\n    \\n    return False\\n\\n# Try it\\ndescended = await explore_and_descend()\\nprint(f\\\"Descended: {descended}\\\")\\n\"}"
          }
        ]
      },
