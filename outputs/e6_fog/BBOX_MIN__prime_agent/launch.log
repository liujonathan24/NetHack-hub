     available = \", \".join(sorted(self._tools)) or \"(none)\"\n291:                 raise AttributeError(\n292:                     f\"'{self.server}' has no tool '{name}'. Available: {available}\"\n293:                 )\n294:             return await self.call_tool(name, kwargs)\n295: \n296:         _call.__name__ = name\n297:         _call.__qualname__ = f\"{type(self).__name__}.{name}\"\n298:         if self._tools and name in self._tools:\n299:             schema = self._tools[name].get(\"inputSchema\") or {}\n300:             desc = self._tools[name].get(\"description\") or \"\"\n301:             _call.__doc__ = f\"{desc}\\n\\nArguments (JSON Schema):\\n{json.dumps(schema, indent=2)}\"\n302:         return _call\n303: \n304: \n305: def _parse_result(result: Any) -> Any:\n306:     \"\"\"Normalize a CallToolResult into plain Python (structured output preferred).\n307: \n308:     Raises McpToolError when the server flags the result as an error, so a failed\n309:     tool call doesn't look like a successful one to the caller.\n310:     \"\"\"\n311:     texts: list[str] = []\n312:     for block in getattr(result, \"content\", None) or []:\n313:         text = getattr(block, \"text\", None)\n314:         if text is not None:\n315:             texts.append(text)\n316:     if getattr(result, \"isError\", False):\n317:         raise McpToolError(\"\\n\".join(texts) or \"MCP tool returned an error\")\n318: \n319:     structured = getattr(result, \"structuredContent\", None)\n320:     if structured is not None:  # falsy-but-valid payloads ({} / []) are real results\n321:         return structured\n322:     if texts:\n323:         return \"\\n\".join(texts)\n324: \n325:     # Non-text content (images, embedded resources): return them as plain dicts\n326:     # rather than the opaque SDK object so callers get usable data.\n327:     blocks = getattr(result, \"content\", None) or []\n328:     if blocks:\n329:         return [b.model_dump(mode=\"json\") if hasattr(b, \"mode