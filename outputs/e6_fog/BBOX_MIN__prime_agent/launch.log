            "arguments": "{\"code\": \"\\ntools = await nethack.list_tools()\\nfor t in tools:\\n    print(t['name'], '-', t['description'][:120])\\n    if 'inputSchema' in t:\\n        props = t['inputSchema'].get('properties', {})\\n        for pname, pinfo in props.items():\\n            print(f\\\"    {pname}: {pinfo.get('type','?')} - {pinfo.get('description','')[:80]}\\\")\\n\"}"
          }
