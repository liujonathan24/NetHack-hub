        "content": "246:     - else it's on the host network -> localhost to a local consumer, a host tunnel to a remote one.\"\"\"\n247:     if colocated:\n248:         yield f\"http://127.0.0.1:{port}\"\n249:     elif not service.is_local:  # in a remote sandbox → it publishes its own port\n250:         yield await service.expose(port)\n251:     elif consumer_is_local:  # host network, local consumer → localhost, no tunnel\n252:         yield f\"http://127.0.0.1:{port}\"\n253:     else:  # host network, remote consumer → a host tunnel publishes the port outward\n254:         async with PrimeTunnel().expose(port) as url:\n255:             yield url\n256: \n257: \n258: @contextlib.asynccontextmanager\n259: async def serve(\n260:     server: ServerBase,\n261:     harness_runtime: Runtime | None = None,\n262:     for_host: bool = False,\n263:     harness_is_local: bool = True,\n264:     *,\n265:     state_secret: str = \"\",\n266:     state_base: str | None = None,\n267: ):\n268:     cfg = server.config\n269:     async with contextlib.AsyncExitStack() as stack:\n270:         if getattr(cfg, \"colocated\", False) and harness_runtime is not None:\n271:             runtime = harness_runtime\n272:         else:\n273:             runtime = make_runtime(cfg.runtime)\n274:             await runtime.start()\n275:             stack.push_async_callback(runtime.stop)\n276:         # Only consumers outside the server runtime need its fixed published port. Colocated tools\n277:         # use independent OS-assigned ports, avoiding clashes on the runtime's service port.\n278:         exposed = for_host or runtime is not harness_runtime\n279:         # The shared-state channel: every server reaches the interception at the rollout's\n280:         # `state_base`, which is universally reachable (the interception is exposed via a tunnel\n281:         # whenever any consumer is remote). Eval-level shared servers get no per-rollout channel\n282:         # (`state_base` is None for them).\n283:         state_url = (\n284:             f\"{runtime.host_url(state_base.rstrip('/'))}/state\" if state_base else None\n285:         )\n286:         port = await serve_in_runtime(\n287:             server,\n288:             runtime,\n289:             exposed=exposed,\n290:             state_url=state_url,\n291:             state_secret=state_secret,\n292:         )\n293:         # Who consumes the server decides reachability: a user sim is reached by the HOST\n294:         # (`for_host`, always local, never colocated with it); a tool by the harness — colocated\n295:         # when it shares the harness's runtime, reached with the harness's locality (read off the\n296:         # harness runtime when there is one, else `harness_is_local` for an eval-level shared tool).\n297:         if for_host:\n298:             colocated, consumer_is_local = False, True\n299:         else:\n300:             colocated = runtime is harness_runtime\n301:             consumer_is_local = (\n302:                 harness_runtime.is_local\n303:                 if harness_runtime is not None\n304:                 else harness_is_local\n305:             )\n306:         base = await stack.enter_async_context(\n307:             reachable_url(\n308:                 runtime, port, colocated=colocated, consumer_is_local=consumer_is_local\n309:             )\n310:         )\n",
