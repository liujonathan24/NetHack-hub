            "name": "ipython",
            "arguments": "{\"code\": \"\\n# Let me check the schema for the tools I'll use most frequently\\nfor tool_name in ['np_move_to', 'np_go_to', 'np_explore_level', 'np_melee_attack', 'np_down', 'np_up', 'np_pickup', 'np_look', 'rollback', 'reveal']:\\n    try:\\n        t = getattr(nethack, tool_name)\\n        help(t)\\n    except Exception as e:\\n        print(f\\\"{tool_name}: {e}\\\")\\n    print()\\n\"}"
