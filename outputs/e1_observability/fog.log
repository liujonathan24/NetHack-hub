        "role": "tool",
        "tool_call_id": "call_8f2NVzonWOYD5dEvq13dYntG",
        "content": "509: def create_inventory_command(command: IntEnum, command_name, command_description: str):\n510:     @skill(\n511:         name=command_name,\n512:         description=command_description,\n513:         parameters=[\n514:             SkillParameter.string(\"item_letter\", optional=True)\n515:         ]\n516:     )\n517:     def command_skill(agent: NetHackAgent, item_letter: str=None):\n518:         yield agent.step(command)\n519:         if item_letter and agent.waiting_for_popup():\n520:             yield from press_key(agent, key=item_letter)\n521:         else:\n522:             yield Step.completed()\n523: \n524:     return command_skill\n525: \n526: def create_position_command(command: IntEnum, command_name: str, command_description: str):\n527:     @skill(\n528:         name=command_name,\n529:         description=command_description,\n530:         parameters=[\n531:             SkillParameter.integer(\"x\", optional=True),\n532:             SkillParameter.integer(\"y\", optional=True)\n533:         ]\n534:     )\n535:     def command_skill(agent: NetHackAgent, x: int=None, y: int=None):\n536:         if x is not None and y is not None and (x != agent.blstats.x or y != agent.blstats.y):\n537:             yield Step.think(f\"Moving to ({x},{y})\")\n538: \n539:             failed = False\n540:             for step in move_to(agent, x, y):\n541:                 failed = failed or step.has_failed()\n542:                 if step.is_done():\n543:                     break\n544:                 yield step\n545: \n546:             if failed or agent.blstats.x != x or agent.blstats.y != y:\n547:                 yield Step.failed(f\"Failed to reach position ({x},{y}).\")\n548:                 return\n549:         \n550:         yield agent.step(command)\n551:         yield Step.completed()\n552: \n553:     return command_skill\n554: \n555: def create_direction_command(command: IntEnum, command_name: str, command_description: str):\n556:     @skill(\n557:         name=command_name,\n558:         description=command_description,\n559:         parameters=[\n560:             SkillParameter.integer(\"x\"),\n561:             SkillParameter.integer(\"y\")\n562:         ]\n563:     )\n564:     def command_skill(agent: NetHackAgent, x: int=None, y: int=None):\n565:         target_neighbors = agent.current_level.get_neighbors(x, y, include_diagonal=True)\n566:         # Filter unreachable neighbors\n567:         target_neighbors = [(x,y) for (x,y) in target_neighbors if agent.get_path_to(x,y) is not None]\n568:         nx, ny = min(target_neighbors, key=lambda pos: agent.distance_to(pos[0], pos[1], bump_into_unwalkables=False))\n569: \n570:         failed = False\n571:         for step in move_to(agent, nx, ny):\n572:             failed = failed or step.has_failed()\n573:             if step.is_done():\n574:                 break\n575:             yield step\n576:         if failed or agent.blstats.x != nx or agent.blstats.y != ny:\n577:             yield Step.failed(f\"Failed to get close to ({x},{y})\")\n578:             return\n579:             \n580:         yield agent.step(command)\n581:         yield agent.step(get_move_action(agent.blstats.x, agent.blstats.y, x, y))\n582:         yield Step.completed()\n583: \n584:     return command_skill\n585: \n586: @skill(\n587:     name=\"zap\",\n588:     description=\"Zap a wand in the given cardinal (n, e, s, w) or ordinal direction (ne, se, sw, nw) or target yourself using self.\",\n",
