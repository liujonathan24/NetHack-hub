            "arguments": "{\"code\": \"\\n# Let me try monkey-patching to use a longer timeout\\nimport httpx\\nfrom contextlib import asynccontextmanager\\n\\noriginal_open_session = nh._open_session.__func__\\n\\nasync def patched_open_session(self, stack):\\n    import inspect as _inspect\\n    from mcp import ClientSession\\n    from mcp.client import streamable_http as mod\\n    \\n    url, extra_headers = await self._resolve_config()\\n    if not url:\\n        raise ValueError(f\\\"{type(self).__name__} must set `url` or override `_open_session`\\\")\\n    token = await self._resolve_token()\\n    \\n    # Find the transport function\\n    for name in (\\\"streamablehttp_client\\\", \\\"streamable_http_client\\\"):\\n        transport = getattr(mod, name, None)\\n        if transport is not None:\\n            break\\n    \\n    params = _inspect.signature(transport).parameters\\n    auth_header = {**extra_headers, \\\"Authorization\\\": f\\\"Bearer {token}\\\"}\\n    \\n    if \\\"http_client\\\" in params or \\\"headers\\\" not in params:\\n        # Use http_client with longer timeout\\n        client = await stack.enter_async_context(\\n            httpx.AsyncClient(headers=auth_header, timeout=httpx.Timeout(300.0, connect=30.0))\\n        )\\n        cm = transport(url, http_client=client)\\n    else:\\n        # headers is available, but we need to inject timeout via http_client\\n        # Check if both params exist\\n        if \\\"http_client\\\" in params:\\n            client = await stack.enter_async_context(\\n                httpx.AsyncClient(headers=auth_header, timeout=httpx.Timeout(300.0, connect=30.0))\\n            )\\n            cm = transport(url, http_client=client)\\n        else:\\n            cm = transport(url, headers=auth_header)\\n    \\n    read, write, *_ = await stack.enter_async_context(cm)\\n    session = await stack.enter_async_context(ClientSession(read, write))\\n    await session.initialize()\\n    return session\\n\\nnh